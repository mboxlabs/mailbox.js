{
  "name": "@mboxlabs/mailbox",
  "version": "2.0.0",
  "license": "MIT",
  "author": "Riceball LEE <snowyu.lee@gmail.com>",
  "homepage": "https://github.com/mboxlabs/mailbox.js",
  "bugs": {
    "url": "https://github.com/mboxlabs/mailbox.js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mboxlabs/mailbox.js.git"
  },
  "description": "A lightweight, pluggable mailbox kernel inspired by the Erlang Actor Model. It treats all communication as delivering a message to an address, enabling fault-tolerant, distributed, and human-computer collaborative systems.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build-fast": "tsup",
    "build": "pnpm run build-fast --dts-resolve --dts && pnpm run doc:md",
    "clean": "rm -fr web docs dist",
    "doc": "typedoc --plugin none --out web",
    "doc:md": "typedoc --plugin typedoc-plugin-markdown --out docs",
    "style": "pnpm run format && pnpm run lint",
    "style:fix": "pnpm run format:fix && npm run lint:fix",
    "format": "prettier --check \"**/*.{md,json,jsonc,yaml,yml}\"",
    "format:fix": "prettier --write \"**/*.{md,json,jsonc,yaml,yml}\"",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint --fix",
    "test": "pnpm run typecheck && vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "release": "pnpm run clean && pnpm run build && git add -f docs && (git diff --cached --quiet -- docs || git commit -m 'docs: update API docs' -- docs) && pnpm dlx commit-and-tag-version@12.7.3 -s",
    "release.alpha": "pnpm run release -- --prerelease alpha"
  },
  "dependencies": {
    "@isdk/hash": "workspace:^"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.10.1",
    "@fastify/formbody": "^8.0.2",
    "@types/inquirer": "^8.2.12",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^26.1.0",
    "@typescript-eslint/eslint-plugin": "~8.41.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-tsdoc": "^0.4.0",
    "fastify": "^5.6.1",
    "inquirer": "^8.2.6",
    "prettier": "^3.9.10",
    "terser": "^5.44.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "type-fest": "^4.41.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "~5.7.3",
    "vite": "^7.1.4",
    "vitest": "^3.2.4",
    "vitest-fetch-mock": "^0.4.5"
  },
  "files": [
    "docs",
    "dist",
    "LICENSE-MIT",
    "CHANGELOG.md"
  ],
  "keywords": [
    "mailbox",
    "actor-model",
    "message-queue",
    "async",
    "rpc",
    "transport"
  ],
  "maintainers": [
    "Riceball LEE <snowyu.lee@gmail.com>"
  ],
  "engines": {
    "node": ">=20.11.1"
  },
  "types": "./dist/index.d.ts"
}
